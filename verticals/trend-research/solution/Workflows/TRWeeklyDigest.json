                      "type": "SetVariable",
                      "inputs": {
                        "name": "DigestHTML",
                        "value": "<html lang=\"{{locale}}\">\n<head>\n<meta charset=\"utf-8\">\n<title>{{t:digest.title}}</title>\n</head>\n<body>\n<h1>{{t:digest.title}}</h1>\n<h2>{{t:digest.briefHeading}}</h2>\n<p>@{items('Loop_Brief')?['Title']}</p>\n<p>\n<strong>{{t:digest.product}}:</strong> @{items('Loop_Brief')?['Product']}<br>\n<strong>{{t:digest.dimension}}:</strong> @{if(equals(items('Loop_Brief')?['Dimension']?['Value'], 'Market'), '{{t:codes.dimension.Market}}', if(equals(items('Loop_Brief')?['Dimension']?['Value'], 'Technology'), '{{t:codes.dimension.Technology}}', if(equals(items('Loop_Brief')?['Dimension']?['Value'], 'Regulatory'), '{{t:codes.dimension.Regulatory}}', if(equals(items('Loop_Brief')?['Dimension']?['Value'], 'Competition'), '{{t:codes.dimension.Competition}}', items('Loop_Brief')?['Dimension']?['Value']))))}<br>\n<strong>{{t:digest.question}}:</strong> @{items('Loop_Brief')?['field_1']}<br>\n<strong>{{t:digest.reportingWindow}}:</strong>\n@{variables('WindowStartDate')} {{t:digest.through}} @{variables('WindowEndDate')}\n</p>\n<h2>{{t:digest.pipelineSummary}}</h2>\n<ul>\n<li>{{t:digest.digestSignalsIncluded}}: @{length(body('Get_Digest_Signals')?['value'])}</li>\n</ul>\n<h2>{{t:digest.topFindings}}</h2>"
