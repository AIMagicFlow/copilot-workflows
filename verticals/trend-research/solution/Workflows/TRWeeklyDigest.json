              "metadata": {
                "description": "Build WindowStart",
                "nodeId": "variable-7a18a37e-de93-4da8-9a2b-2749322455fc"
              }
            },
            "Build_WindowStart_Init_WindowStartDate": {
              "type": "SetVariable",
              "inputs": {
                "name": "WindowStartDate",
                "value": "@{formatDateTime(addDays(utcNow(), -7), 'yyyy-MM-dd')}"
              },
              "runAfter": {
                "Build_WindowStart": [
                  "Succeeded"
                ]
              }
            },
            "Build_WindowEnd": {
              "type": "SetVariable",
