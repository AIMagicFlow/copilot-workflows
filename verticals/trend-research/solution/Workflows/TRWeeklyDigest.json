          },
          "metadata": {
            "description": "Get Enabled Briefs",
            "nodeId": "connector-16e0a9dd-705a-43de-929a-ad2ae6be2c47"
          }
        },
        "Loop_Brief": {
          "type": "Foreach",
          "foreach": "@coalesce(body('Get_Enabled_Briefs')?['value'], json('[]'))",
          "runtimeConfiguration": {
            "concurrency": {
              "repetitions": 1
            }
          },
          "actions": {
            "Build_WindowStart": {
              "type": "SetVariable",
              "inputs": {
                "name": "WindowStart",
