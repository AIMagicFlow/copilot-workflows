{
  "profiles": [
    {
      "id": "default-pii",
      "rules": [
        {
          "id": "email",
          "pattern": "[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\\.[A-Za-z]{2,}",
          "replacement": "[REDACTED_EMAIL]",
          "enabled": true
        },
        {
          "id": "phone",
          "pattern": "(?<![\\w+])(?:\\+\\d{1,3}[ .-]?)?(?:\\(\\d{2,4}\\)[ .-]?)?(?:\\d{9,15}|\\d{2,4}(?:[ .-]\\d{2,4}){1,4})(?!\\w)",
          "replacement": "[REDACTED_PHONE]",
          "enabled": true,
          "validator": "phone"
        }
      ]
    }
  ]
}
